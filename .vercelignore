# Vercel CLI uploads the working directory and does NOT honour .gitignore.
# Without this file `vercel --prod` tried to upload .claude/worktrees/ — ~124 GB
# of per-worktree node_modules — and failed with "Request body too large.
# Limit: 10mb", blocking a production deploy needed to bind a new env var.
#
# Git-push deploys build server-side from the repo and were never affected, so
# this only matters for a manual CLI deploy. Tracked files under .claude/
# (agents, commands, settings) are NOT needed by the build.
.claude/
node_modules
.next
tsconfig.tsbuildinfo
.tmp-probe/

# ── Added 2026-09-21 ────────────────────────────────────────────────────────
# Everything above was already excluded and STAYS excluded; these are additions.
#
# `git status --porcelain` hides gitignored files, so the deploy guard was only
# enumerating ordinary untracked ones — the smaller half of what a CLI deploy
# uploads. Re-enumerating with `--ignored` surfaced all of these: gitignored, and
# none of them excluded here, i.e. not provably kept out of an upload.
#
# The env files are why this is worth doing carefully. They hold live credentials,
# and Vercel injects real env vars from project settings, so there is never a
# reason to upload one. `.env.*` also covers the timestamped
# `.env.local.*-backup` files, which is the shape a literal list would miss.
.env
.env.*

# Local caches, OS/editor droppings, local run state, CLI link metadata.
# These are unanchored, so they also match at depth (e.g. docs/.DS_Store).
.cache/
.DS_Store
.vercel/
.recompete-sweep-state.json
tasks/logs/

# Generated by `next build`; never needs uploading.
next-env.d.ts

# Local one-off HTML previews.
preview-briefing-email.html
preview-tab-design.html
