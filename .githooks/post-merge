#!/usr/bin/env bash
#
# Post-merge branch tidy. Runs after a `git pull`/`git merge` on main and REPORTS local
# branches that are fully merged into origin/main — the residue GitHub's
# `delete_branch_on_merge` can never clear, because it deletes its own copy of the branch and
# never yours. (Verified 2026-08-17: that setting was already ON and working — zero merged
# branches remained on origin — while the LOCAL list had reached 516.)
#
# REPORTS ONLY. It never deletes on its own: a hook that silently removes refs is exactly the
# kind of surprise that makes people disable hooks. It prints the count and the one command to
# run. Deleting stays an explicit act (`npm run tidy:branches -- --go`).
#
# Enabled via `core.hooksPath=.githooks` (same as pre-push; auto-set by npm's prepare script).

set -uo pipefail
# ⚠️ SAME BUG AS pre-push: deriving the root from the hook FILE's location is
# wrong whenever core.hooksPath is an absolute path shared by every worktree —
# this reported on the PRIMARY checkout no matter where the merge happened.
# Report-only here, but it is the identical defect, so it uses the identical
# fix. See .githooks/resolve-checkout.sh.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# Same ownership rule as pre-push: this hook must not run the PRIMARY
# checkout's reporting logic against a different worktree while pretending it
# belongs there. Report-only, so a mismatch is silent rather than blocking.
if ! ROOT="$("$HOOK_DIR/resolve-checkout.sh" "$HOOK_DIR" 2>/dev/null)"; then
  exit 0
fi
cd "$ROOT" || exit 0

# Only on main — mid-feature merges into a topic branch are noise.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
[ "$branch" = "main" ] || exit 0

[ -f scripts/tidy-branches.mjs ] || exit 0

out="$(node scripts/tidy-branches.mjs --quiet 2>/dev/null || true)"
# Print only when there is something to prune (the script is silent otherwise under --quiet).
if [ -n "$out" ] && printf '%s' "$out" | grep -q "prunable"; then
  printf '%s\n' "$out" | head -6
fi

exit 0
