#     ZERO variables and failed later with errors pointing nowhere near the cause.
#     ⚠️ Step 12's `[ ! -f .env.local ]` test FOLLOWS the symlink, so that exact breakage makes
#     it report "skipped cleanly" — the check designed to notice missing creds is blind to it.
#     This step uses -L/-e and catches it. WARN-ONLY: .env.local is developer-local and
#     gitignored, so a hard block would wedge any machine that has not set it up — same
#     contract as steps 9-12.
echo -e "  ${BOLD}13/13${NC} .env.local usability (warn only)…"
if [ ! -e .env.local ] && [ ! -L .env.local ]; then
  echo -e "      ${YEL}— skipped: no .env.local on this machine${NC}"
elif npm run --silent verify:env > /tmp/mindy-prepush-env.log 2>&1; then
  echo -e "      ${GREEN}✓ .env.local is readable, populated, and correctly linked${NC}"
else
  echo -e "      ${YEL}⚠ .env.local is NOT usable — local runners would load zero variables (NOT blocking):${NC}"
  grep -E "^  \u2022" /tmp/mindy-prepush-env.log | head -4 | sed 's/^/        /'
  echo -e "      ${YEL}  (detail: npm run verify:env)${NC}"
fi

if [ "$fail" -ne 0 ]; then
  echo -e "${RED}${BOLD}✗ push blocked by pre-push gate.${NC} Fix the above, or \`git push --no-verify\` for a genuine emergency."
  exit 1
fi
echo -e "${GREEN}${BOLD}✓ pre-push gate passed.${NC}"
exit 0
