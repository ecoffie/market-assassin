{
  "name": "market-assassin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:whitepaper": "node scripts/build-whitepaper-docx.mjs",
    "ingest:mcp-docs": "node scripts/ingest-mcp-docs.js",
    "test": "bash tests/run-all-tests.sh",
    "test:pre-deploy": "bash tests/test-pre-deploy.sh",
    "test:local": "bash tests/test-pre-deploy.sh --local",
    "test:schema": "node tests/test-schema-sync.js",
    "audit:supabase-errors": "node scripts/audit-supabase-errors.mjs",
    "audit:persist-expansion": "node scripts/audit-persist-expansion.mjs",
    "verify:data": "npx tsx scripts/verify-data-truth.ts",
    "eval:cap-parse": "npx tsx scripts/eval-cap-parse.ts",
    "eval:evidence-match": "npx tsx scripts/eval-evidence-match.ts",
    "audit:api-auth": "node scripts/audit-api-auth.js",
    "launch:brief": "node scripts/generate-launch-manager-brief.js",
    "seo:contractor-candidates": "node scripts/generate-seo-contractor-candidates.js",
    "predeploy": "npm run test:schema && npm run test:unit && npm run test:pre-deploy && npm run verify:data && npm run verify:m-scale && npm run eval:cap-parse && npm run eval:evidence-match",
    "deploy": "npm run predeploy && vercel --prod",
    "experiment:dry-run": "DRY_RUN=true npx tsx scripts/assign-experiment-cohorts.ts",
    "experiment:execute": "DRY_RUN=false npx tsx scripts/assign-experiment-cohorts.ts",
    "rag:repair:dry-run": "node scripts/repair-rag-corpus.js",
    "rag:repair:apply": "node scripts/repair-rag-corpus.js --apply",
    "rag:templates:dry-run": "node scripts/ingest-proposal-template-corpus.js",
    "rag:templates:apply": "node scripts/ingest-proposal-template-corpus.js --apply",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepush": "bash .githooks/pre-push",
    "audit:client-auth": "node scripts/audit-client-auth.mjs",
    "audit:email-sender": "node scripts/audit-email-sender.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "mcp:dev": "node scripts/mcp-dev.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "mcp:smoke:http": "node scripts/mcp-http-smoke.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:m-scale": "npx tsx scripts/verify-m-scale.mjs",
    "verify:search": "npx tsx --tsconfig tsconfig.json scripts/verify-search.mjs",
    "verify:oracles": "npx tsx --tsconfig tsconfig.json scripts/verify-oracles.mjs",
    "verify:ma-skills": "node scripts/verify-ma-skills.mjs",
    "ingest:awards": "npx tsx scripts/ingest-usaspending-awards.ts",
    "ingest:awards:apply": "npx tsx scripts/ingest-usaspending-awards.ts --apply",
    "db": "node scripts/db.mjs",
    "db:check": "node scripts/db.mjs --check",
    "report:intel": "node scripts/report-intel.mjs",
    "demo:reset": "npx tsx scripts/demo-reset.ts",
    "migrate": "npx tsx scripts/migrate.ts",
    "migrate:status": "npx tsx scripts/migrate.ts status",
    "migrate:baseline": "npx tsx scripts/migrate.ts baseline",
    "check:zero-alerts": "node scripts/check-zero-alert-drop.mjs",
    "ledger:audit": "node scripts/audit-repair-ledger.mjs",
    "tidy:branches": "node scripts/tidy-branches.mjs",
    "test:chain": "vitest run src/mcp/decision-chain --exclude \"**/*.live.test.ts\"",
    "test:chain:live": "vitest run src/mcp/decision-chain/*.live.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/storage": "^7.19.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.90.0",
    "@tanstack/react-query": "^5.100.9",
    "@upstash/qstash": "^2.11.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "docx": "^9.6.1",
    "driver.js": "^1.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "mcp-handler": "^1.1.0",
    "next": "16.2.9",
    "nodemailer": "^7.0.12",
    "pdf-parse": "^2.4.5",
    "puppeteer-core": "^25.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "stripe": "^20.1.0",
    "twilio": "^5.12.2",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^27.3.0",
    "pg": "^8.20.0",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "fast-xml-parser": "^5.9.3",
    "axios": "^1.18.1",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "mcp-handler": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    }
  }
}
